# Listen address.
GHIDRAREST_ADDR=:8080

# Where jobs, uploads and artifacts live. One directory per job.
GHIDRAREST_DATA_DIR=/data

# Ghidra install and the directory holding ExportJSON.java. Both are already
# correct inside the image; set them only when running the released binary
# against your own Ghidra.
GHIDRAREST_GHIDRA_HOME=/opt/ghidra
GHIDRAREST_SCRIPT_DIR=/opt/ghidra-rest/scripts

# Largest accepted upload (256 MiB).
GHIDRAREST_MAX_UPLOAD_BYTES=268435456

# Concurrent Ghidra runs, and how many submissions may wait behind them.
# Each run is a JVM that will use up to GHIDRAREST_JAVA_MAX_MEM, so this is
# the main memory lever. Default: half the CPUs, capped at 4.
GHIDRAREST_MAX_CONCURRENT=2
GHIDRAREST_QUEUE_SIZE=64

# Wall clock budget for one analysis. Ghidra's own analysis timer is set to
# three quarters of this, so it stops analysing in time to still write results.
GHIDRAREST_ANALYSIS_TIMEOUT=30m

# Decompile every function during analysis. Turning this off makes jobs much
# faster and leaves /function/{addr}/decompile empty.
GHIDRAREST_DECOMPILE=true

# Per-function decompiler timeout, and how many functions to decompile before
# giving up on the rest.
GHIDRAREST_DECOMPILE_TIMEOUT=60
GHIDRAREST_DECOMPILE_MAX_FUNCS=20000

# Cap on the raw memory bytes exported per program, which is what
# /hexdump/{addr} reads from (256 MiB).
GHIDRAREST_MAX_EXPORT_BYTES=268435456

# JVM heap for each headless run, passed through as Ghidra's MAXMEM.
GHIDRAREST_JAVA_MAX_MEM=2G

# Cap Ghidra's own worker threads. 0 leaves it to Ghidra.
GHIDRAREST_MAX_CPU=0

# Keep the Ghidra project directory after analysis. This is what signature
# editing re-opens, so leaving it on is what makes PUT
# /v1/results/{id}/function/{addr}/signature work at all -- see
# docs/SIGNATURES.md. It also lets you open the result in the Ghidra GUI.
# Setting it to false costs you retyping, per job, permanently: a job analysed
# without a project cannot grow one later.
GHIDRAREST_KEEP_PROJECT=true

# Bounds one apply-signature run. Far below the analysis timeout on purpose:
# that run is -noanalysis, so it is a JVM start plus a few decompilations.
GHIDRAREST_SIGNATURE_TIMEOUT=10m

# Delete finished jobs older than this. Empty or 0 keeps them forever.
GHIDRAREST_RETENTION=

# Shared bearer token. Empty means every endpoint is open, which is fine on a
# loopback bind and nowhere else.
GHIDRAREST_API_TOKEN=

# Set to an origin (or *) to enable CORS for a browser front end.
GHIDRAREST_CORS_ORIGIN=

# Per-request logging.
GHIDRAREST_VERBOSE=false

# Pagination defaults for the list endpoints, and the hexdump byte cap.
GHIDRAREST_PAGE_SIZE=100
GHIDRAREST_MAX_PAGE_SIZE=5000
GHIDRAREST_MAX_HEXDUMP_BYTES=65536
